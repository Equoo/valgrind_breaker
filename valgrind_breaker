#!/usr/bin/env bash
#
# valgrind_breaker: malloc failure injection on top of the system valgrind.
#
#   valgrind_breaker [valgrind options] [breaker options] prog [args...]
#
# Breaker options:
#   --fail=<n>      fail the Nth allocation
#   --fail-all      also fail every allocation after the Nth
#   --count         print the allocation counters at exit
#   --main-only     only count allocations requested by the main executable
#   --ignore=a,b    don't count allocations requested by objects whose path
#                   contains a or b (e.g. readline)
#   --auto          fail each allocation in turn, report problems
#   --from=<n>      first allocation to fail in auto mode [1]
#   --to=<n>        last allocation to fail in auto mode [count]
#   -j <n>, --jobs=<n>  parallel runs in auto mode [nproc]
#
# Environment: VALGRIND (valgrind binary to use) [valgrind]

set -uo pipefail

HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
VALGRIND=${VALGRIND:-valgrind}

MAGENTA=$'\033[1;35m'
GREEN=$'\033[1;32m'
RESET=$'\033[0m'
CLEAR=''
[[ -t 1 ]] && CLEAR=$'\r\033[K'

usage() {
    sed -n '3,19s/^# \{0,1\}//p' "$0"
    exit "${1:-0}"
}

number() {
    if [[ ! "$2" =~ ^[0-9]+$ ]]; then
        echo "valgrind_breaker: $1 expects a number" >&2
        exit 2
    fi
    echo "$2"
}

########################################
# Arguments
########################################

VG_ARGS=()
AUTO=0
START=1
MAX=0
JOBS=$(nproc)
unset MALLOC_FAIL_AT MALLOC_FAIL_ALL MALLOC_FAIL_COUNT MALLOC_FAIL_COUNT_FILE \
    MALLOC_FAIL_ONLY_MAIN MALLOC_FAIL_IGNORE MALLOC_FAIL_NOVG

while (($#)); do
    case "$1" in
        --fail=*)       export MALLOC_FAIL_AT=$(number "${1%%=*}" "${1#*=}") || exit ;;
        --fail-all)     export MALLOC_FAIL_ALL=1 ;;
        --count)        export MALLOC_FAIL_COUNT=1 ;;
        --main-only)    export MALLOC_FAIL_ONLY_MAIN=1 ;;
        --ignore=*)     export MALLOC_FAIL_IGNORE=${1#*=} ;;
        --auto)         AUTO=1 ;;
        --from=*)       START=$(number "${1%%=*}" "${1#*=}") || exit ;;
        --to=*)         MAX=$(number "${1%%=*}" "${1#*=}") || exit ;;
        --jobs=*)       JOBS=$(number "${1%%=*}" "${1#*=}") || exit ;;
        -j)             JOBS=$(number -j "${2-}") || exit; shift ;;
        -j*)            JOBS=$(number -j "${1#-j}") || exit ;;
        -h|--help)      usage ;;
        --)             shift; break ;;
        -*)             VG_ARGS+=("$1") ;;
        *)              break ;;
    esac
    shift
done

PROG=("$@")
((${#PROG[@]})) || usage 2

########################################
# Preload setup
########################################

if [[ ! -f "$HERE/libmalloc_breaker.so" || ! -f "$HERE/libmalloc_breaker_cxx.so" ]]; then
    make -s -C "$HERE" >&2 || exit 1
fi

PRELOAD="$HERE/libmalloc_breaker.so"
PROG_PATH=$(command -v "${PROG[0]}" || true)
if [[ -n "$PROG_PATH" ]] && ldd "$PROG_PATH" 2>/dev/null | grep -q 'libstdc++'; then
    PRELOAD="$HERE/libmalloc_breaker_cxx.so:$PRELOAD"
fi

# Without it, memcheck also replaces the shim's malloc.
run_valgrind() {
    LD_PRELOAD="$PRELOAD${LD_PRELOAD:+:$LD_PRELOAD}" "$VALGRIND" \
        --soname-synonyms=somalloc=nouserintercepts "$@"
}

strip_shim_frames() {
    awk '
        function pid() { match($0, /^==[0-9]+==/); return substr($0, RSTART, RLENGTH) }
        / (at|by) 0x[0-9A-Fa-f]+: / &&
        /\((malloc_breaker(_cxx)?\.cc?|valgrind\.h):[0-9]+\)|\(in [^)]*libmalloc_breaker/ {
            if (/ at 0x/) promote[pid()] = 1
            next
        }
        / by 0x[0-9A-Fa-f]+: / && promote[pid()] {
            sub(/ by 0x/, " at 0x")
            promote[pid()] = 0
        }
        { print; fflush() }'
}

if ((!AUTO)); then
    if [[ " ${VG_ARGS[*]} " =~ \ --(log-fd|log-file|log-socket|xml)= ]]; then
        run_valgrind "${VG_ARGS[@]}" "${PROG[@]}"
        exit
    fi
    # FIFO: a --log-fd would stay open in the program.
    LOG_DIR=$(mktemp -d "${TMPDIR:-/tmp}/valgrind_breaker.XXXXXX")
    mkfifo "$LOG_DIR/log"
    strip_shim_frames < "$LOG_DIR/log" >&2 &
    FILTER=$!
    run_valgrind --log-file="$LOG_DIR/log" "${VG_ARGS[@]}" "${PROG[@]}"
    STATUS=$?
    # Unblock the filter if the log was never opened.
    exec 5<>"$LOG_DIR/log"
    exec 5>&-
    wait "$FILTER"
    rm -rf "$LOG_DIR"
    exit "$STATUS"
fi

########################################
# Auto mode
########################################

WORK=$(mktemp -d "${TMPDIR:-/tmp}/valgrind_breaker.XXXXXX")
# Background jobs ignore SIGINT.
kill_tree() {
    local child
    for child in $(pgrep -P "$1"); do
        kill_tree "$child"
    done
    kill -TERM "$1" 2>/dev/null
}

stop() {
    local pid
    for pid in $(jobs -p); do
        kill_tree "$pid"
    done
    wait 2>/dev/null
    rm -rf "$WORK"
    exit 130
}
trap stop INT TERM

STDIN_FILE=/dev/null
if [[ ! -t 0 ]]; then
    STDIN_FILE="$WORK/stdin"
    cat > "$STDIN_FILE"
fi

failing_site() {
    cat "$@" | strip_shim_frames | awk '
        /Failing malloc call/ { found = 1; next }
        found && /(at|by) 0x/ {
            sub(/^==[0-9]+== +(at|by) 0x[0-9A-Fa-f]+: /, "")
            site = site (n++ ? " <- " : "") $0
            if (n == 3) exit
            next
        }
        found && n && !/(at|by) 0x/ { exit }
        END { print site }'
}

run_one() {
    local index="$1"
    local logs
    local problems=()

    MALLOC_FAIL_AT="$index" run_valgrind \
        --leak-check=full \
        --show-leak-kinds=all \
        --errors-for-leak-kinds=none \
        --track-origins=yes \
        "${VG_ARGS[@]}" \
        --log-file="$WORK/$index.%p.log" \
        "${PROG[@]}" < "$STDIN_FILE" > /dev/null 2>&1

    logs=("$WORK/$index".*.log)
    if ! grep -q 'Failing malloc call' "${logs[@]}" 2>/dev/null; then
        rm -f "${logs[@]}"
        return
    fi

    local signals leaks errors
    signals=$(sed -n 's/.*Process terminating with default action of signal [0-9]* (\(SIG[A-Z0-9]*\)).*/\1/p' \
        "${logs[@]}" | sort -u | paste -sd, -)
    leaks=$(cat "${logs[@]}" | grep -c 'in loss record')
    errors=$(sed -n 's/.*ERROR SUMMARY: \([0-9,]*\) errors.*/\1/p' "${logs[@]}" \
        | tr -d , | awk '{ s += $1 } END { print s + 0 }')
    [[ -n "$signals" ]] && problems+=("$signals")
    ((leaks)) && problems+=("$leaks leak(s)")
    ((errors)) && problems+=("$errors error(s)")

    if ((${#problems[@]} == 0)); then
        rm -f "${logs[@]}"
        return
    fi

    local joined
    joined=$(IFS=,; echo "${problems[*]}")
    printf '%s%s#%-5s %s%s  at %s\n' "$CLEAR" "$MAGENTA" "$index" "${joined//,/, }" "$RESET" \
        "$(failing_site "${logs[@]}")"
    local log
    for log in "${logs[@]}"; do
        strip_shim_frames < "$log" > "$log.tmp" && mv "$log.tmp" "$log"
    done
    : > "$WORK/problem.$index"
}

progress() {
    [[ -n "$CLEAR" ]] || return 0
    local total=$((MAX - START + 1))
    local problems
    problems=$(find "$WORK" -name 'problem.*' | wc -l)
    printf '%s[%d/%d] %d%% | %d problem(s) | %dm%02ds' "$CLEAR" \
        "$DONE" "$total" $((DONE * 100 / total)) "$problems" \
        $((SECONDS / 60)) $((SECONDS % 60))
}

[[ -n "$CLEAR" ]] && printf 'Counting allocations...'
COUNT_FILE="$WORK/count"
MALLOC_FAIL_COUNT_FILE="$COUNT_FILE" run_valgrind -q --log-file=/dev/null \
    "${PROG[@]}" < "$STDIN_FILE" > /dev/null 2>&1
if [[ ! -s "$COUNT_FILE" ]]; then
    printf "%s" "$CLEAR"
    echo "valgrind_breaker: failed to count allocations" \
        "(did the program exit through exit()/return from main?)" >&2
    rm -rf "$WORK"
    exit 1
fi
read -r BREAKABLE SUPPRESSED < "$COUNT_FILE"
printf '%s' "$CLEAR"
echo "Breakable allocations: $BREAKABLE ($SUPPRESSED suppressed)"

((MAX > 0)) || MAX=$BREAKABLE

DONE=0
SECONDS=0
progress
for ((i = START; i <= MAX; i++)); do
    while (($(jobs -rp | wc -l) >= JOBS)); do
        wait -n
        ((DONE++))
        progress
    done
    run_one "$i" &
done
while (($(jobs -rp | wc -l) > 0)); do
    wait -n
    ((DONE++))
    progress
done
printf '%s' "$CLEAR"

PROBLEMS=$(find "$WORK" -name 'problem.*' | wc -l)
if ((PROBLEMS)); then
    echo "${MAGENTA}$PROBLEMS failing allocation(s) out of $((MAX - START + 1)) caused problems${RESET}"
    echo "Logs kept in $WORK (<n>.<pid>.log)"
    rm -f "$WORK"/problem.* "$WORK/stdin" "$COUNT_FILE"
    exit 1
fi
echo "${GREEN}No problems in $((MAX - START + 1)) failing allocation(s)${RESET}"
rm -rf "$WORK"
